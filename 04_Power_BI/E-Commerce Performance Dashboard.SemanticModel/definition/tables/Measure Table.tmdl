			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Geography & Market
		lineageTag: 7d60da48-40f2-4850-b2fb-38f589fb2eed

	measure 'Category Sales Rank' =
			
			VAR CategoryTable =
			    ALL('Category Lookup'[Display Category Name])
			
			RETURN
			    RANKX(
			        CategoryTable,
			        CALCULATE([Category Sales]),
			        ,
			        DESC,
			        DENSE
			    )
		formatString: #,0
		displayFolder: Product & Category Performance
