			DISTINCTCOUNT('OrderItems Data'[Order_ID])
		formatString: #,0
		displayFolder: Product & Category Performance
		lineageTag: 57f73689-9a7e-4f03-8f08-1f460dc87600

	measure 'Category AOV' =
			
			DIVIDE(
			    [Category Sales],
			    [Category Orders]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Product & Category Performance
		lineageTag: e467369e-313e-4fee-8ef8-9234235f617e

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Product AOV' =
			
			DIVIDE(
			    [Product Sales],
			    [Product Orders]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Product & Category Performance
		lineageTag: 7dc32371-21cd-4125-a69b-b9d672bdd791

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Product Order Contribution %' =
			
			DIVIDE(
			    [Product Orders],
			    CALCULATE(
			        DISTINCTCOUNT('OrderItems Data'[Order_ID]),
			        REMOVEFILTERS('Product Lookup')
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Product & Category Performance
		lineageTag: b98a7079-6d25-43a5-8c77-9b2999863b7b

	measure 'Product Delivered Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT('Orders Data'[OrderID]),
			    'Orders Data'[Order_Status] = "delivered",
			    TREATAS(
			        VALUES('OrderItems Data'[Order_ID]),
			        'Orders Data'[OrderID]
			    )
			)
		formatString: #,0
		displayFolder: Logistics & Operations
		lineageTag: 04384c05-1bd9-4f37-b5ab-caaf13caa759

	measure 'Product Delivery Rate' =
			
			DIVIDE(
			    [Product Delivered Orders],
			    [Product Orders],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics & Operations
		lineageTag: 298a596a-9ad5-4487-8691-f43ef31e9efa

	measure 'Product Late Delivery Rate' =
			
			VAR ProductOrderIDs =
			    VALUES('OrderItems Data'[Order_ID])
			
			VAR LateProductOrders =
			    CALCULATE(
			        DISTINCTCOUNT('Orders Data'[OrderID]),
			        'Orders Data'[Late_Delivery_Flag] = 1,
			        TREATAS(
			            ProductOrderIDs,
			            'Orders Data'[OrderID]
			        )
			    )
			
			RETURN
			    DIVIDE(
			        COALESCE(LateProductOrders,0),
			        [Product Orders]
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics & Operations
		lineageTag: 3fb3fd04-26ff-478a-a369-fe16cff2e62b

	measure 'Product Average Late Delivery Days' =
			
			VAR ProductOrderIDs =
			    VALUES('OrderItems Data'[Order_ID])
			
			RETURN
			    COALESCE(
			        CALCULATE(
			            [Average Late Delivery Days],
			            TREATAS(
			                ProductOrderIDs,
			                'Orders Data'[OrderID]
			            )
			        ),
			        0
			    )
		formatString: 0
		displayFolder: Logistics & Operations
		lineageTag: 98645a34-25ae-4e6a-a0fd-9da3834c71cf

	measure 'Geography Sales' =
			
			[Gross Sales]
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Geography & Market
		lineageTag: 0b7d4e6f-c5df-4e4b-b8e2-41626e3265ac

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Geography Orders' =
			
			[Total Orders]
		formatString: #,0
		displayFolder: Geography & Market
		lineageTag: a0396ce7-b37a-4edb-922c-6ef603834f01

	measure 'Geography Sales Contribution %' =
			
			DIVIDE(
			    [Geography Sales],
			    CALCULATE(
			        [Gross Sales],
			        REMOVEFILTERS('Geography Lookup')
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Product & Category Performance
		lineageTag: 755bf67d-c469-4bcc-a652-283f588fc904

	measure 'Geography Customers' =
			
			DISTINCTCOUNT(
			    'Customer Lookup'[Customer_Unique_ID]
			)
		formatString: #,0
		displayFolder: Geography & Market
		lineageTag: 6bdee778-6849-41a3-8d97-16d780446064

	measure 'Review Count' =
			
			COUNTROWS('OrderReviews Data')
		formatString: #,0
		displayFolder: Customer Experience
		lineageTag: 08d310ff-9b49-4a85-a0f7-41816a8c7cdf

	measure 'Review Score %' =
			
			DIVIDE(
			    [Review Count],
			    CALCULATE(
			        [Review Count],
			        REMOVEFILTERS('OrderReviews Data'[Review_Score])
			    ),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Experience
		lineageTag: 5ec1a1d7-5d58-4588-a8c1-ac2d5506d61d

	measure 'Payment Orders' =
			
			DISTINCTCOUNT('OrderPayment Data'[Order_ID])
		formatString: #,0
		displayFolder: Payment Analytics
		lineageTag: e5f265ee-9384-40c0-a9c8-0106552268e1

	measure 'Payment Method %' =
			
			DIVIDE(
			    [Payment Orders],
			    CALCULATE(
			        [Payment Orders],
			        REMOVEFILTERS('OrderPayment Data'[Payment_Type])
			    ),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Payment Analytics
		lineageTag: 403174ef-7c71-45eb-b13c-d19d2a76bb29

	measure 'Average Installments' =
			
			AVERAGE('OrderPayment Data'[Payment_Installments])
		formatString: 0.00
		displayFolder: Payment Analytics
		lineageTag: 5e751a65-e8d5-420b-92a4-5af0f2a144d3

	measure 'Installment Usage %' =
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT('OrderPayment Data'[Order_ID]),
			        'OrderPayment Data'[Payment_Installments] > 1
			    ),
			    [Payment Orders],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Payment Analytics
		lineageTag: 73941afa-1670-4674-a69d-d5192439beae

	measure 'Payment Value' =
			
			SUM('OrderPayment Data'[Payment_Value])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Payment Analytics
		lineageTag: 5d5c5cf2-e80c-45a0-853d-84d8ec1f8839

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Not Delivered Orders' =
			
			[Total Orders] - [Delivered Orders]
		formatString: 0
		displayFolder: Order Performance
		lineageTag: 7c889d1d-95bd-4b08-80fb-b94a67343cf4

	measure 'Top Sales Category' =
			
			VAR TopCategory =
			    TOPN(
			        1,
			        ALL('Category Lookup'[Display Category Name]),
			        [Category Sales],
			        DESC
			    )
			RETURN
			    CONCATENATEX(
			        TopCategory,
			        'Category Lookup'[Display Category Name],
			        ", "
			    )
		displayFolder: Product & Category Performance
		lineageTag: 82613738-1d2b-4d83-abd9-bd4364ed722e

	measure 'Top Sales State' =
			
			VAR TopState =
			    TOPN(
			        1,
			        ALL('Geography Lookup'[State]),
			        [Geography Sales],
			        DESC
			    )
			RETURN
			    CONCATENATEX(
			        TopState,
			        'Geography Lookup'[State],
			        ", "
			    )
		displayFolder: Executive KPIs
		lineageTag: 9ba7952f-ff16-437b-9013-97c795a6de1c

	measure 'Previous Month Gross Sales' =
			
			CALCULATE(
			    [Gross Sales],
			    DATEADD('Calendar Lookup'[Full Date], -1, MONTH)
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 4bba4d91-f86a-487b-87a1-596321ff142f

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Previous Month Orders' =
			
			CALCULATE(
			    [Total Orders],
			    DATEADD('Calendar Lookup'[Full Date], -1, MONTH)
			)
		formatString: #,0
		lineageTag: b6efaf9c-4f51-4c28-baee-78bba94dab27

	measure 'Previous Month Late Delivery Rate' =
			
			CALCULATE(
			    [Late Delivery Rate],
			    DATEADD('Calendar Lookup'[Full Date], -1, MONTH)
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f98c0049-caf1-46af-a9cf-13485f321856

	measure 'Single Order Customers' =
			
			[Total Customers] - [Repeat Customers]
		formatString: #,0
		lineageTag: c02d5cba-3602-413b-a7d6-619d67174a94

	measure 'Customer Review Score' = ```
			
			CALCULATE(
			    AVERAGE('OrderReviews Data'[Review_Score]),
			    USERELATIONSHIP(
			        'Orders Data'[OrderID],
			        'OrderReviews Data'[Order_ID]
			    )
			)
			    
			```
		displayFolder: Customer Experience
		lineageTag: 92bc527b-e06a-42ac-96c9-a77dd01a7210

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Retention Rate (Selected Period)' =
			
			VAR SelectedYear =
			    MAX('Calendar Lookup'[Year])
			RETURN
			    CALCULATE(
			        [Customer Retention Rate],
			        REMOVEFILTERS('Calendar Lookup'),
			        'Calendar Lookup'[Year] = SelectedYear
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Experience
		lineageTag: 6bdf8bf1-9bba-4673-83c6-e72b46642173

	measure 'Customer Retention Rate' = ```
			
			 DIVIDE(     
			        [Retained Customers],         
			        [Total Customers] 
			)
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Experience
		lineageTag: 0b66c885-a1de-4348-9302-4973c1a9b795

	measure 'Top High Risk Seller ID' =
			
			VAR RiskySellers =
			    FILTER(
			        ALL('Seller Lookup'[SellerKey]),
			        CALCULATE([High Risk Seller Rate]) = 1
			    )
			VAR TopSeller =
			    TOPN(
			        1,
			        RiskySellers,
			        CALCULATE([Seller Late Delivery Rate]),
			        DESC
			    )
			VAR TopSellerKey =
			    MAXX(
			        TopSeller,
			        'Seller Lookup'[SellerKey]
			    )
			RETURN
			    CALCULATE(
			        SELECTEDVALUE('Seller Lookup'[Seller_ID]),
			        'Seller Lookup'[SellerKey] = TopSellerKey
			    )
		lineageTag: f77ba6ab-6962-4dcb-b555-a4e3391d7d51

	measure 'Selected Seller ID'
		lineageTag: e18af972-17e2-41b7-b0fd-fe14ad3f9049

	measure 'Adjusted Product Sales' =
			
			[Product Sales] *
			(1 + [Price Adjustment (%) Value])
		lineageTag: 7255cd83-9498-4c95-8c5b-d28f6615c5c5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition 'Measure Table' = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

