table 'Measure Table'
	lineageTag: f89c62ac-f4a7-4dba-85c7-446838deab10

	measure 'Gross Sales' =
			
			SUM('OrderItems Data'[Price])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Executive KPIs
		lineageTag: a0d378f1-547a-4826-b477-f4c29a48b203

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Total Orders' =
			
			COUNTROWS('Orders Data')
		formatString: #,0
		displayFolder: Executive KPIs
		lineageTag: afa6259b-79d7-41a2-b936-b56ad9a986dc

	measure 'Total Order Items' =
			
			COUNTROWS('OrderItems Data')
		formatString: #,0
		displayFolder: Order Performance
		lineageTag: fbe645bd-3848-4ce3-820b-0781ce4bf157

	measure 'Total Customers' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('Customer Lookup'[Customer_Unique_ID]),
			        CALCULATE([Total Orders]) > 0
			    )
			)
		formatString: #,0
		displayFolder: Executive KPIs
		lineageTag: 484f71ca-d57f-47c9-acd0-d0a427b1e1d7

	measure 'Average Order Value' =
			
			DIVIDE(
			        [Gross Sales],
			        [Total Orders]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Executive KPIs
		lineageTag: 65c43374-1ae9-40ba-ae86-993d584ce75a

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Average Review Score' =
			
			AVERAGE('OrderReviews Data'[Review_Score])
		formatString: 0.00
		displayFolder: Executive KPIs
		lineageTag: 293beb58-56c2-4195-9bd2-4c3d99f0b806

	measure 'Average Delivery Days' =
			
			AVERAGE('Orders Data'[Delivery_Days])
		formatString: #,0
		displayFolder: Executive KPIs
		lineageTag: f43f21be-2102-494f-92ae-f17bba9a093f

	measure 'Delivered Orders' =
			
			CALCULATE(
			    [Total Orders],
			    'Orders Data'[Order_Status] = "delivered"
			)
		formatString: #,0
		displayFolder: Order Performance
		lineageTag: 03b95369-13a0-4114-944c-f20a7d876f35

	measure 'Delivered Sales' =
			
			CALCULATE(
			    [Gross Sales],
			    'Orders Data'[Order_Status] = "delivered"
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Sales Performance
		lineageTag: 73791b57-712e-48f5-97dd-069c740652f3

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Delivery Rate' =
			
			DIVIDE(
			        [Delivered Orders],
			        [Total Orders]
			    )
		formatString: 0%;-0%;0%
		displayFolder: Logistics & Operations
		lineageTag: e4a2c378-c53f-46e1-b716-46cc837ae256

	measure 'Canceled Orders' =
			
			CALCULATE(
			    [Total Orders],
			    'Orders Data'[Order_Status] = "canceled"
			)
		formatString: #,0
		displayFolder: Order Performance
		lineageTag: 7629ba2a-4ac1-4d09-857f-ebba52db311e

	measure 'Cancellation Rate' =
			
			DIVIDE(
			        [Canceled Orders],
