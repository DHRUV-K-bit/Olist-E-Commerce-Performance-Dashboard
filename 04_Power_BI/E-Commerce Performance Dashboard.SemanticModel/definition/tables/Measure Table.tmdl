		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics & Operations
		lineageTag: ecd78c5e-388b-420b-ba00-4aca61fe9bd7

	measure 'Late Delivery Orders' =
			
			CALCULATE(
			    [Total Orders],
			    'Orders Data'[Late_Delivery_Flag] = 1,
			    'Orders Data'[Order_Status] = "delivered"
			)
		formatString: #,0
		displayFolder: Order Performance
		lineageTag: b1c02122-b7a8-4fa2-8b17-8fdefda3bd79

	measure 'Late Delivery Rate' =
			
			DIVIDE(
			    [Late Delivery Orders],
			    [Delivered Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics & Operations
		lineageTag: 1503baf7-c626-408a-86a8-799c85cf3811

	measure 'Early Delivery Orders' =
			
			CALCULATE(
			    [Total Orders],
			    'Orders Data'[Early_Delivery_Flag] = 1,
			    'Orders Data'[Order_Status] = "delivered"
			)
		formatString: #,0
		displayFolder: Order Performance
		lineageTag: 6153d2f5-f7bf-4efe-82fa-88f5c4846355

	measure 'Early Delivery Rate' =
			
			DIVIDE(
			        [Early Delivery Orders],
			        [Delivered Orders]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics & Operations
		lineageTag: d486419b-bb9b-417c-a587-51e74834d1f6

	measure 'Average Items per Order' =
			
			DIVIDE(
			        [Total Order Items],
			        [Total Orders]
			)
		formatString: 0.00
		displayFolder: Order Performance
		lineageTag: dc2dfa66-939b-4211-81d0-6805f6351a76

	measure 'Repeat Customers' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('Customer Lookup'[Customer_Unique_ID]),
			        CALCULATE([Total Orders]) > 1
			    )
			)
		formatString: #,0
		displayFolder: Customer Experience
		lineageTag: 24f4ef2a-3e4b-4f1a-b2b5-d3fe5b765f58

	measure 'Repeat Customer Rate' =
			
			DIVIDE(
			        [Repeat Customers],
			        [Total Customers]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Experience
		lineageTag: a97fc1bf-c6cc-4eef-a7f0-30433d9f8f78

	measure 'Sales per Customer' =
			
			DIVIDE(
			        [Delivered Sales],
			        [Total Customers]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Customer Experience
		lineageTag: fdfef41a-1d57-4c98-9fa1-e320ff03d052

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Orders per Customer' =
			
			DIVIDE(
			        [Total Orders],
			        [Total Customers]
			)
		formatString: 0
		displayFolder: Customer Experience
		lineageTag: c46590c8-1daa-4c3b-8233-2915027ae26e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Retained Customers' =
			
			
			VAR CurrentYear =
			    SELECTEDVALUE('Calendar Lookup'[Year])
			
			VAR CurrentYearCustomerKeys =
			    VALUES('Orders Data'[CustomerKey])
			
			VAR CurrentYearCustomers =
			    CALCULATETABLE(
			        VALUES('Customer Lookup'[Customer_Unique_ID]),
			        TREATAS(
			            CurrentYearCustomerKeys,
			            'Customer Lookup'[CustomerKey]
			        )
			    )
			
			VAR NextYearCustomerKeys =
			    CALCULATETABLE(
			        VALUES('Orders Data'[CustomerKey]),
			        REMOVEFILTERS('Calendar Lookup'),
			        'Calendar Lookup'[Year] = CurrentYear + 1
			    )
			
			
			VAR NextYearCustomers =
			    CALCULATETABLE(
			        VALUES('Customer Lookup'[Customer_Unique_ID]),
			        TREATAS(
			            NextYearCustomerKeys,
			            'Customer Lookup'[CustomerKey]
			        )
			    )
			
			RETURN
			    COUNTROWS(
			        INTERSECT(
			            CurrentYearCustomers,
			            NextYearCustomers
			        )
			    )
		formatString: #,0
		displayFolder: Customer Experience
		lineageTag: 58e2967c-ca60-4bfe-b64a-53e6ad5a49b2

	measure 'Positive Review Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('OrderReviews Data'),
			        'OrderReviews Data'[Review_Score] >= 4
			    ),
			    COUNTROWS('OrderReviews Data')
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Experience
		lineageTag: b8d6d475-639b-4e1b-86d5-8bffa1e68380

	measure 'Poor Review Rate' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('OrderReviews Data'),
			        'OrderReviews Data'[Review_Score] <= 2
			    ),
			    COUNTROWS('OrderReviews Data')
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customer Experience
		lineageTag: 52187178-7848-433d-8361-96c044cc4553

	measure 'Average Item Price' =
			
			AVERAGE('OrderItems Data'[Price])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Sales Performance
		lineageTag: ece4c590-40a7-49de-bfed-3538d60fd3f4

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Previous Year Delivered Sales' =
			
			CALCULATE(
			    [Delivered Sales],
			    DATEADD(
			        'Calendar Lookup'[Full Date],
			        -1,
			        YEAR
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Sales Performance
		lineageTag: 06f417d3-71c4-4c12-9a41-db21976d1b7b

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'YoY Delivered Sales Growth %' =
			
			DIVIDE(
			        [Delivered Sales] - [Previous Year Delivered Sales],
			        [Previous Year Delivered Sales]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sales Performance
		lineageTag: e2bca269-b3b9-42e6-bf5d-a48a7cfc56e8

	measure 'Average Freight Cost' =
			
			AVERAGE('OrderItems Data'[Freight_Value])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Logistics & Operations
		lineageTag: 608053c6-9dc1-48f7-9d37-bd7a595ebba7

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Freight Cost % of Sales' =
			
			DIVIDE(
			        SUM('OrderItems Data'[Freight_Value]),
			        SUM('OrderItems Data'[Price])
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Logistics & Operations
		lineageTag: c7f2ff99-3063-428f-bcbc-93bbec0ad298

	measure 'Total Freight' =
			
			SUM('OrderItems Data'[Freight_Value])
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Logistics & Operations
		lineageTag: aa8420d2-acff-4fef-9916-646213f75dbe

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Delivered Sales %' =
			
			DIVIDE(
			        [Delivered Sales],
			        [Gross Sales]
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Sales Performance
		lineageTag: 7d58bafc-545d-4bb8-a6b2-8e2e29cb40a0

	measure 'Average Late Delivery Days' =
			
			AVERAGEX(
			    FILTER(
			        'Orders Data',
			        'Orders Data'[Order_Status] = "delivered"
			            && 'Orders Data'[Late_Delivery_Flag] = 1
			            && NOT ISBLANK('Orders Data'[Customer_Delivery_Date])
			            && NOT ISBLANK('Orders Data'[Estimated_Delivery_Date])
			    ),
			    DATEDIFF(
			        'Orders Data'[Estimated_Delivery_Date],
			        'Orders Data'[Customer_Delivery_Date],
			        DAY
			    )
			)
		formatString: 0
		displayFolder: Logistics & Operations
		lineageTag: 95ba5ed3-eef0-4021-ab6f-9c05ded17a04

	measure 'Total Sellers' =
			
			DISTINCTCOUNT('OrderItems Data'[SellerKey])
		formatString: #,0
		displayFolder: Seller Performance
		lineageTag: e01de4a6-999a-43f4-9411-2d1fbc660f40

	measure 'Seller Sales' =
			
			CALCULATE(
			    SUM('OrderItems Data'[Price]),
			    USERELATIONSHIP(
			        'OrderItems Data'[SellerKey],
			        'Seller Lookup'[SellerKey]
			    )
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Seller Performance
		lineageTag: ffe39b6f-a07c-4358-b8a3-ac371dbbe915

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Seller Orders' =
			
			CALCULATE(
			    DISTINCTCOUNT('OrderItems Data'[Order_ID]),
			    USERELATIONSHIP(
			        'OrderItems Data'[SellerKey],
			        'Seller Lookup'[SellerKey]
			    )
			)
		formatString: #,0
		displayFolder: Seller Performance
		lineageTag: 1ef5aeef-7330-4c33-b7ba-69e2d00714b4

	measure 'Seller AOV' =
			
			DIVIDE(
			        [Seller Sales],
			        [Seller Orders]
			)
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Seller Performance
		lineageTag: 62ec2aa5-a84c-4140-a2b4-70544cae6c33

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Seller Delivery Rate' =
			
			VAR SellerOrderIDs =
			    CALCULATETABLE(
			        VALUES('OrderItems Data'[Order_ID]),
			        USERELATIONSHIP(
			            'OrderItems Data'[SellerKey],
			            'Seller Lookup'[SellerKey]
			        )
			    )
			
			VAR DeliveredSellerOrders =
			    CALCULATE(
			        DISTINCTCOUNT('Orders Data'[OrderID]),
			        'Orders Data'[Order_Status] = "delivered",
			        TREATAS(
			            SellerOrderIDs,
			            'Orders Data'[OrderID]
			        )
			    )
			
			RETURN
			    DIVIDE(
			        DeliveredSellerOrders,
			        [Seller Orders]
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seller Performance
		lineageTag: abd3c24b-70c8-48e4-8e4a-7f3ad643a03e

	measure 'Seller Late Delivery Rate' = ```
			
			
			VAR SellerOrderIDs = 
			    CALCULATETABLE(
			        VALUES('OrderItems Data'[Order_ID]),
			        USERELATIONSHIP(
			            'OrderItems Data'[SellerKey],
			            'Seller Lookup'[SellerKey]
			        )
			    )
			
			VAR LateSellerOrders = 
			    CALCULATE(
			        DISTINCTCOUNT('Orders Data'[OrderID]),
			        'Orders Data'[Late_Delivery_Flag] = 1,
			        TREATAS(
			            SellerOrderIDs,
			            'Orders Data'[OrderID]
			        )
			    )
			
			RETURN 
			    DIVIDE(
			            COALESCE(LateSellerOrders,0),
			            [Seller Orders]
			    )
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seller Performance
		lineageTag: ad0bd094-6a69-4a2b-b4ac-ffcdea7bee5c

	measure 'Seller Sales Contribution %' =
			
			DIVIDE(
			        [Seller Sales],
			        CALCULATE(
			            [Gross Sales],
			            REMOVEFILTERS('Seller Lookup')
			        )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seller Performance
		lineageTag: c332845a-40d2-47ec-a2af-88d627cb2a0a

	measure 'Seller Sales Rank' = ```
			
			RANKX(
			    ALL('Seller Lookup'[Seller_ID]),
			    [Seller Sales],
			    ,
			    DESC,
			    Dense
			)
			
			```
		formatString: 0
		displayFolder: Seller Performance
		lineageTag: dd5b46e1-81ec-4125-8dd7-afcc078f59d2

	measure 'Top 10 Seller' =
			
			IF(
			    [Seller Sales Rank] <= 10,
			    1,
			    0
			)
		formatString: 0
		displayFolder: Seller Performance
		lineageTag: 2ffe7727-d0b5-46c3-ab4a-aa652b720ecb

	measure 'Seller Late Delivery Rank' =
			
			RANKX(
			    ALL('Seller Lookup'[Seller_ID]),
			    [Seller Late Delivery Rate],
			    ,
			    DESC,
			    Dense
			)
		formatString: 0
		displayFolder: Seller Performance
		lineageTag: 1811f7bc-6a90-4ab4-bf82-34319c243c4d

	measure 'High Risk Seller Rate' =
			
			VAR OverallLateRate =
			    CALCULATE(
			        [Late Delivery Rate],
			        REMOVEFILTERS('Seller Lookup')
			    )
			RETURN
			    IF(
			        [Seller Orders] >= 100
			            && [Seller Late Delivery Rate] > OverallLateRate,
			        [Seller Late Delivery Rate],
			        BLANK()
			    )
		formatString: 0%;-0%;0%
		displayFolder: Seller Performance
		lineageTag: 62f1ba6f-cf42-4de3-b517-726630c88d3c

	measure 'Top 10 Seller Sales Contribution %' =
			
			VAR TopSellers =
			    TOPN(
			        10,
			        ALL('Seller Lookup'[SellerKey]),
			        [Seller Sales],
			        DESC
			    )
			
			VAR TopSellerSales =
			    CALCULATE(
			        [Seller Sales],
			        TopSellers
			    )
			
			VAR TotalSales =
			    CALCULATE(
			        [Gross Sales],
			        REMOVEFILTERS('Seller Lookup')
			    )
			
			RETURN
			    DIVIDE(
			        TopSellerSales,
			        TotalSales
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Seller Performance
		lineageTag: 5b711eee-fb61-476f-b221-53d4a7acc17d

	measure 'Total Products' =
			
